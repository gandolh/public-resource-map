{
  "name": "@public-resource-map/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-users": "tsx src/db/seed-users.ts",
    "db:set-role": "tsx src/db/set-role.ts",
    "db:capture-osm": "tsx src/db/capture-osm.ts",
    "test": "vitest run --root .. --project backend"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@public-resource-map/shared": "*",
    "better-sqlite3": "12.11.1",
    "close-with-grace": "2.5.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.0.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
