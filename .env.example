# Public Resource Map: local environment. Copy to `.env` at the repo root.
#
# `npm run dev` loads that file into both the backend and the UI dev server
# (node --env-file-if-exists), so this is the one place to set them. The deploy
# does not read it; vps-deploy passes its own values.

# --- Ward (sign-in) ---------------------------------------------------------
# Required. The backend refuses to boot without all three
# (backend/src/ward/config.ts). Locally they point at Ward's container, see
# ../wzd_auth/infrastructure/local: its seed.mjs writes a working WARD_APP_KEY
# into your .env. With the placeholder key the public map still works and
# signing in does not.
WARD_PUBLIC_ORIGIN=http://localhost:8792
WARD_API_BASE_PATH=/ward-api
WARD_APP_KEY=wak_replace_me

# --- UI dev server ------------------------------------------------------------
# Local dev is served the way the deploy is: the app under /prm/, its API under
# /prm-api and Ward under /ward, all on http://localhost:5173 (ui/vite.config.ts
# proxies the last two). Open http://localhost:5173/prm/.
PRM_BASE=/prm/
VITE_API_URL=/prm-api

# Optional. Without a CARTO key the map falls back to OpenStreetMap tiles,
# filtered toward the same look (ui/app/lib/map.ts).
# VITE_CARTO_API_KEY=

# Where a source publisher asks to be removed, shown on /about-data (brief 09).
# Set it before launch; without it the page says the address is being set up.
# VITE_DATA_CONTACT=

# --- Backend (optional; defaults shown) ------------------------------------------

# Event ingestion (brief 04). Nominatim's policy requires an identifying
# User-Agent with a contact; without NOMINATIM_USER_AGENT nothing is geocoded
# and every unmatched venue waits for a manual pin. INGEST_USER_AGENT is what
# feeds see; it has a default.
# NOMINATIM_USER_AGENT=CivicMap-prm/0.1 (contact: you@example.ro)
# INGEST_USER_AGENT=
# PORT=3001                      also where the UI dev server proxies /prm-api
# HOST=0.0.0.0
# DATABASE_PATH=                 default backend/data/app.db
# CORS_ORIGIN=http://localhost:5173
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# APP_URL=http://localhost:5173  base of the links in logged mails (backend/src/lib/mailer.ts)
