# Public Resource Map: local environment. Copy to `.env` at the repo root.
#
# `npm run dev` loads that file into both the backend and the UI dev server
# (node --env-file-if-exists), so this is the one place to set them. The deploy
# does not read it; vps-deploy passes its own values.

# --- Accounts (brief 24 of Ward's corpus) ----------------------------------------
# prm keeps its own users (login and register pages are prm's). PUBLIC_ORIGIN
# is the origin the browser loads prm from, no path: the session cookie's
# Secure flag and the same-origin check on sign-in posts depend on it.
PUBLIC_ORIGIN=http://localhost:5173

# Users: `npm run db:seed-users -w backend` creates one from SEED_USERNAME,
# SEED_PASSWORD and SEED_ROLE (user | admin), or asks on the terminal. Set them
# in your shell for that one command, not here. `npm run db:set-role -w backend
# -- <username> admin` promotes an existing user. `npm run db:seed -w backend`
# takes SEED_DEMO_USERNAME (+ SEED_DEMO_PASSWORD) for a demo user with
# favourites.

# --- Sign in with Ward (optional) -----------------------------------------------
# Without WARD_OIDC_ISSUER prm runs on local accounts only. Locally, Ward's
# container (../wzd_auth/infrastructure/local) registers prm as a client and
# its seed.mjs writes all five into your .env. The callback is under the API
# prefix as the browser reaches it.
# WARD_OIDC_ISSUER=http://localhost:8792/ward-api/oidc
# WARD_OIDC_CLIENT_ID=prm
# WARD_OIDC_CLIENT_KEY=           a secret: base64url of prm's private JWK
# WARD_OIDC_REDIRECT_URI=http://localhost:5173/prm-api/auth/ward/callback
# WARD_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/prm/

# --- UI dev server ------------------------------------------------------------
# Local dev is served the way the deploy is: the app under /prm/ and its API
# under /prm-api, both on http://localhost:5173 (ui/vite.config.ts proxies the
# API). Open http://localhost:5173/prm/.
PRM_BASE=/prm/
VITE_API_URL=/prm-api

# Optional. Without a CARTO key the map falls back to OpenStreetMap tiles,
# filtered toward the same look (ui/app/lib/map.ts).
# VITE_CARTO_API_KEY=

# Where a source publisher asks to be removed, shown on /about-data (brief 09).
# A placeholder until the owner sets a real address (decisions.md, 2026-10-04).
VITE_DATA_CONTACT=johndoe@example.com

# --- Backend (optional; defaults shown) ------------------------------------------

# Event ingestion (brief 04). Nominatim's policy requires an identifying
# User-Agent with a contact; without NOMINATIM_USER_AGENT nothing is geocoded
# and every unmatched venue waits for a manual pin. INGEST_USER_AGENT is what
# feeds see; it has a default.
# The contact is the same placeholder; Nominatim expects a reachable one, so put
# in the real address before geocoding at any volume.
NOMINATIM_USER_AGENT=CivicMap-prm/0.1 (contact: johndoe@example.com)
# INGEST_USER_AGENT=
# PORT=3001                      also where the UI dev server proxies /prm-api
# HOST=0.0.0.0
# DATABASE_PATH=                 default backend/data/app.db
# CORS_ORIGIN=http://localhost:5173
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Base of the links in notification mail (backend/src/lib/notify-mail.ts). The
# default is PUBLIC_ORIGIN + PRM_BASE.
# APP_URL=http://localhost:5173/prm
