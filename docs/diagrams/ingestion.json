  "cards": [
    {
      "dot": "emerald",
      "title": "Places are synced",
      "items": [
        "OSM is the anchor because it is ODbL — legal, not technical",
        "A partial unique index on (osm_type, osm_id) makes a re-sync an upsert",
        "Partial, so the venue places with no OSM identity do not collide on NULLs"
      ]
    },
    {
      "dot": "amber",
      "title": "Events are staged",
      "items": [
        "An ingested event becomes a staged_event, never an event",
        "Two independent axes: do we know where it is, has a human decided",
        "So a publisher that starts emitting nonsense cannot quietly publish"
      ]
    },
    {
      "dot": "rose",
      "title": "A failed match is data",
      "items": [
        "source = 'event-venue' means the matcher could not resolve the venue",
        "The raw venue string and address are kept, so a bad match stays diagnosable",
        "A rise in venue places means the matcher or OSM coverage got worse"
      ]
    }
  ]
}
