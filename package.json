{
  "name": "public-resource-map",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "ui",
    "docs"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w ui\"",
    "build": "npm run build -w shared && npm run build -w backend && npm run build -w ui",
    "typecheck": "tsc -b shared && npm run typecheck -w backend && npm run typecheck -w ui && tsc -p e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "1.6.28",
    "concurrently": "9.2.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "^2.1.2"
    },
    "serialize-javascript": "^7.0.5",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "postcss-selector-parser": "^7.1.6",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
